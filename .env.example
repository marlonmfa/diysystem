# Somente no servidor/gateway. Nunca colocar esta chave no aplicativo.
OPENAI_API_KEY=
GATEWAY_PORT=8787
GATEWAY_HOST=127.0.0.1
DIY_GATEWAY_STATE_PATH=var/gateway-state.json
DIY_LICENSE_PUBLIC_KEY=config/license-public.pem

# Modelos podem ser alterados sem recompilar o cliente.
OPENAI_MODEL_MINI=gpt-5.6-terra
OPENAI_MODEL_NORMAL=gpt-5.6-sol

# O endereço do cliente é definido no build:
# flutter run --dart-define=DIY_GATEWAY_URL=http://127.0.0.1:8787
